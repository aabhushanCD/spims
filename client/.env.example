# Base URL for the HTTP API. Use "/api" locally (Vite dev proxy) and in
# production (Vercel rewrite to the backend) so cookies stay first-party.
VITE_API_BASE_URL=/api
# Leave empty locally to derive the socket URL from the page origin and use
# the Vite /ws proxy. In production set the backend socket URL explicitly,
# for example wss://spims-54n0.onrender.com/ws, because the Vercel rewrite
# cannot proxy WebSockets.
VITE_WS_URL=
# Dev-proxy target for /api and /ws (the server defaults to port 3000).
VITE_API_PROXY_TARGET=http://localhost:3000
