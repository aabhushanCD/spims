# Base URL for the HTTP API. Use "/api" to go through the Vite dev proxy.
VITE_API_BASE_URL=/api
# Optional explicit WebSocket URL. Leave empty to derive it from the API origin.
VITE_WS_URL=
# Dev-proxy target for /api and /ws (the server defaults to port 3000).
VITE_API_PROXY_TARGET=http://localhost:3000
