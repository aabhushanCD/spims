MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_GRACE_PERIOD=60s
CLIENT_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_IN=30m
EMAIL_VERIFICATION_EXPIRES_IN=24h
MAX_SESSIONS_PER_USER=10
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW=15m
AUTH_LOCKOUT_DURATION=15m
PORT=
NODE_ENV=
TRUST_PROXY=
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOG_LEVEL=info
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:5174"]
ENABLE_API_DOCS=false

# Used only by `npm run db:seed`; never put a real password here.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=SPIMS Owner
SEED_ALLOW_PRODUCTION=false
# Email delivery. "brevo" uses the Brevo HTTPS API (works on Render free,
# where outbound SMTP ports are blocked); "smtp" uses SMTP_HOST. When unset,
# SMTP_HOST wins over BREVO_API_KEY, then the development JSON transport.
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=SPIMS
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORTING_TIMEZONE=Asia/Kathmandu
VAT_PERCENT=13
SMS_WEBHOOK_URL=
SMS_API_KEY=
